generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model InspectionReport {
  id String @id @default(cuid())
  requestId String @unique
  candidateId String
  observedAt DateTime
  result String
  notes String
  createdAt DateTime @default(now())
  @@index([candidateId, createdAt])
}

enum RawBatchStatus {
  PENDING
  FETCHED
  VALID
  EMPTY
  REJECTED
  FAILED
}

enum FirmsProcessingLevel {
  NRT
  STANDARD
}

// One fetch attempt; repeated downloads append, even when checksums match.
// SQL migration owns lifecycle checks and append-only history triggers.
model RawBatch {
  id                    String               @id @default(cuid())
  sourceId              String
  sourceManifestVersion String
  processingLevel       FirmsProcessingLevel
  productVersion        String?
  regionId              String
  boundaryVersion       String
  regionConfigChecksum  String               @db.VarChar(64)
  requestBbox           Json                 @db.JsonB
  requestedStart        DateTime             @db.Timestamptz(3)
  requestedEnd          DateTime             @db.Timestamptz(3)
  fetchStartedAt        DateTime             @default(now()) @db.Timestamptz(3)
  fetchedAt             DateTime?            @db.Timestamptz(3)
  completedAt           DateTime?            @db.Timestamptz(3)
  checksumSha256        String?              @db.VarChar(64)
  payloadRef            String?              @unique
  payloadBytes          BigInt?
  payloadFormat         String               @default("csv")
  status                RawBatchStatus       @default(PENDING)
  httpStatus            Int?
  errorCode             String?
  retryable             Boolean?
  validatorVersion      String?
  rowCount              Int?
  validationSummary     Json?                @db.JsonB

  @@index([regionId, sourceId, fetchedAt])
  @@index([status, fetchStartedAt])
}

// R2-P1 foundation. Workspace/user/AOI IDs are opaque P0 references for now;
// no synthetic identity tables or production memberships are fabricated here.
enum AnalysisJobStatus {
  queued
  running
  succeeded
  failed
}

enum AnalysisAttemptStatus {
  running
  succeeded
  failed
  expired
}

enum AnalysisArtifactKind {
  observations
  daily
  estimated_grid
}

model AnalysisJob {
  id              String            @id @default(cuid())
  workspaceId     String
  requestedById   String
  requestId       String            @db.Uuid
  analysisKey     String            @db.VarChar(71)
  areaId          String
  areaRevision    Int
  input           Json              @db.JsonB
  status          AnalysisJobStatus @default(queued)
  stage           String?
  progressPercent Float?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  startedAt       DateTime?         @db.Timestamptz(3)
  completedAt     DateTime?         @db.Timestamptz(3)
  resultId        String?           @unique
  error           Json?             @db.JsonB

  attempts        AnalysisJobAttempt[]
  manifests       AnalysisManifest[]
  result          AnalysisResult?      @relation("JobResult")
  publishedResult AnalysisResult?      @relation("PublishedResult", fields: [resultId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, workspaceId])
  @@unique([workspaceId, requestedById, requestId])
  @@index([workspaceId, analysisKey])
  @@index([status, createdAt])
}

model AnalysisJobAttempt {
  id             String                @id @default(cuid())
  jobId          String
  workspaceId    String
  attemptNo      Int
  leaseToken     String                @unique @db.Uuid
  status         AnalysisAttemptStatus @default(running)
  claimedAt      DateTime              @db.Timestamptz(3)
  heartbeatAt    DateTime              @db.Timestamptz(3)
  leaseExpiresAt DateTime              @db.Timestamptz(3)
  completedAt    DateTime?             @db.Timestamptz(3)
  errorCode      String?
  retryable      Boolean?
  job            AnalysisJob           @relation(fields: [jobId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([jobId, attemptNo])
  @@index([status, leaseExpiresAt])
}

model AnalysisManifest {
  id          String           @id @default(cuid())
  jobId       String
  workspaceId String
  dataVersion String
  checksum    String           @db.VarChar(71)
  content     Json             @db.JsonB
  job         AnalysisJob      @relation(fields: [jobId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  results     AnalysisResult[]

  @@unique([id, jobId, workspaceId])
}

model AnalysisResult {
  id               String                       @id @default(cuid())
  jobId            String
  workspaceId      String
  manifestId       String
  dataVersion      String
  generatedAt      DateTime                     @db.Timestamptz(3)
  publishedAt      DateTime                     @db.Timestamptz(3)
  payload          Json                         @db.JsonB
  job              AnalysisJob                  @relation("JobResult", fields: [jobId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  manifest         AnalysisManifest             @relation(fields: [manifestId, jobId, workspaceId], references: [id, jobId, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  publishedBy      AnalysisJob?                 @relation("PublishedResult")
  artifacts        AnalysisArtifact[]
  initialLocations MonitoringLocation[]
  locationLinks    MonitoringLocationAnalysis[]

  @@unique([id, workspaceId])
  @@unique([jobId, workspaceId])
  @@index([workspaceId, publishedAt])
}

model AnalysisArtifact {
  id          String               @id @default(cuid())
  resultId    String
  workspaceId String
  kind        AnalysisArtifactKind
  periodRole  String
  objectKey   String               @unique
  checksum    String               @db.VarChar(71)
  bytes       BigInt
  format      String
  result      AnalysisResult       @relation(fields: [resultId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)

  @@index([resultId, kind, periodRole])
}

model MonitoringLocation {
  id                String                       @id @default(cuid())
  workspaceId       String
  requestId         String                       @db.Uuid
  requestHash       String                       @db.VarChar(71)
  name              String
  anchorDetectionId String
  anchor            Json                         @db.JsonB
  initialAnalysisId String
  areaId            String
  areaRevision      Int
  createdById       String
  createdBy         Json                         @db.JsonB
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  initialAnalysis   AnalysisResult               @relation(fields: [initialAnalysisId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  analyses          MonitoringLocationAnalysis[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, createdById, requestId])
  @@index([workspaceId, createdAt, id])
}

model MonitoringLocationAnalysis {
  locationId  String
  workspaceId String
  analysisId  String
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  location    MonitoringLocation @relation(fields: [locationId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  analysis    AnalysisResult     @relation(fields: [analysisId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)

  @@id([locationId, analysisId])
  @@index([workspaceId, analysisId])
}
