generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model InspectionReport {
  id String @id @default(cuid())
  requestId String @unique
  candidateId String
  observedAt DateTime
  result String
  notes String
  createdAt DateTime @default(now())
  @@index([candidateId, createdAt])
}
