  "required": [
    "schemaVersion",
    "source",
    "hours",
    "bbox",
    "status",
    "fetchedAt",
    "evaluatedAt",
    "freshUntil",
    "observedFrom",
    "observedTo",
    "checksum",
    "total",
    "gridDegrees",
    "unit",
    "features",
    "sample"
  ]
}
