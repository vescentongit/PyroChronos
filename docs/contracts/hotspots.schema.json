  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "hotspots-1"
    },
    "source": {
      "type": "string",
      "enum": [
        "VIIRS_NOAA20_NRT",
        "VIIRS_SNPP_NRT",
        "VIIRS_NOAA21_NRT",
        "MODIS_NRT"
      ]
    },
    "hours": {
      "anyOf": [
        {
          "type": "number",
          "const": 24
        },
        {
          "type": "number",
          "const": 48
        },
        {
          "type": "number",
          "const": 72
        },
        {
          "type": "number",
          "const": 96
        }
      ]
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
