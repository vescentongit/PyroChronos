            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "frp": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "lat",
          "lng",
          "observedAt",
          "satellite",
          "confidence",
          "frp"
        ]
