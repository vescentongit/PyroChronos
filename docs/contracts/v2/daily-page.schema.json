{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "research-2"
    },
    "analysisId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "periodRole": {
      "type": "string",
      "enum": [
        "primary",
        "comparison"
      ]
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "metric": {
            "type": "object",
            "properties": {
              "rawCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "harmonizedCount": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rawCountsBySource": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "available",
                  "partial",
                  "no_data",
                  "method_unsupported"
                ]
              }
            },
            "required": [
              "rawCount",
              "harmonizedCount",
              "rawCountsBySource",
              "status"
            ],
            "additionalProperties": false
          },
          "anomaly": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "assessed",
                  "insufficient_history",
                  "insufficient_data",
                  "method_unsupported"
                ]
              },
              "referenceYears": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 2000,
                  "maximum": 9007199254740991
                }
              },
              "baselineStatistic": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "mean",
                      "median"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "baselineValue": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "delta": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "scoreKind": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "percentile",
                      "z-score"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "status",
              "referenceYears",
              "baselineStatistic",
              "baselineValue",
              "delta",
              "scoreKind",
              "score"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "date",
          "metric",
          "anomaly"
        ],
        "additionalProperties": false
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "analysisId",
    "periodRole",
    "month",
    "days",
    "nextCursor"
  ],
  "additionalProperties": false
}
