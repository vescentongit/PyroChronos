{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "research-2"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "user": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "displayName"
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "member"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "workspaceId",
    "user",
    "role",
    "active",
    "revision"
  ],
  "additionalProperties": false
}
